{
  "name": "no-caddy-needed",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios --device \"iPhone 17\"",
    "web": "expo start --web",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "test:changed": "jest --onlyChanged",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test:e2e": "maestro test .maestro/start-round.yaml",
    "test:e2e:stats": "maestro test .maestro/stats-flow.yaml",
    "ui:check": "node scripts/ui-diff.js",
    "ui:update": "node scripts/ui-update.js",
    "metrics": "node scripts/metrics.js",
    "prepare": "husky"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "collectCoverageFrom": [
      "app/**/*.{ts,tsx}",
      "components/**/*.{ts,tsx}",
      "service/**/*.{ts,tsx}",
      "!**/__tests__/**",
      "!**/*.test.{ts,tsx}",
      "!**/*.spec.{ts,tsx}",
      "!**/index.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "statements": 50,
        "branches": 50,
        "functions": 50,
        "lines": 50
      }
    }
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@testing-library/react-native": "^13.0.1",
    "expo": "^58.0.22",
    "expo-asset": "~58.0.19",
    "expo-audio": "~58.0.11",
    "expo-background-task": "~58.0.12",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.14",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-sharing": "~58.0.21",
    "expo-speech": "~58.0.3",
    "expo-speech-recognition": "~58.0.1",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-store-review": "~58.0.2",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "firebase": "^12.11.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-toast-message": "^2.2.1",
    "react-native-toast-notifications": "^3.4.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "30.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~58.0.4",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "lint-staged": "^16.2.7",
    "pixelmatch": "^5.3.0",
    "react-test-renderer": "19.3.0",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-toast-notifications",
          "expo-av"
        ]
      }
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "npx eslint --fix",
      "jest --findRelatedTests --passWithNoTests"
    ]
  },
  "private": true,
  "overrides": {
    "expo-router": {
      "@testing-library/react-native": "$@testing-library/react-native"
    }
  }
}
